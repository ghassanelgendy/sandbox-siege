# Sandbox Siege Container Environment Configuration

# LocalStack Auth Token (Required for Ultimate-tier IAM/RDS/EC2)
LOCALSTACK_AUTH_TOKEN=your_localstack_token_here

# LLM Provider API Keys
BYNARA_API_KEY=your_bynara_key_here
DAHL_API_KEY=your_dahl_key_here

# Cloudflare Tunnel Token (For custom domain access)
# If using a Named Tunnel token from Cloudflare Zero Trust:
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
CLOUDFLARE_TUNNEL_COMMAND=tunnel --no-autoupdate run

# Or for a Quick Free TryCloudflare Tunnel (No token required):
# CLOUDFLARE_TUNNEL_COMMAND=tunnel --url http://siege-frontend:80
